<Window x:Class="AgendaApp.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Klusbedrijf Agenda" Height="720" Width="1100" MinHeight="550" MinWidth="820" WindowStartupLocation="CenterScreen">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#173B50" Padding="20,14"><TextBlock Text="Klusbedrijf Agenda" Foreground="White" FontSize="24" FontWeight="SemiBold"/></Border>
    <StackPanel DockPanel.Dock="Left" Width="190" Background="#F1F5F7" Margin="0">
      <TextBlock Text="NAVIGATIE" Margin="15,18,15,8" Foreground="#52616B" FontSize="11"/>
      <Button Content="Klantportaal" Click="CustomerDashboard_Click"/>
      <Button Content="Mijn agenda" Click="AgendaView_Click"/>
      <Button Content="Diensten" Click="Services_Click"/>
      <Button Content="Reviews" Click="Reviews_Click"/>
      <Button Content="Contact" Click="Contact_Click"/>
      <Separator Margin="10,12"/>
      <Button Content="Beheerportaal" Click="AdminDashboard_Click"/>
      <Button Content="Afspraken beheren" Click="AgendaEdit_Click"/>
    </StackPanel>
    <ContentControl x:Name="PageHost" Margin="22"/>
  </DockPanel>
</Window>
