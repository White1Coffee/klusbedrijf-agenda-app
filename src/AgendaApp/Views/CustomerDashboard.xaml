<UserControl x:Class="AgendaApp.Views.CustomerDashboard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel><TextBlock Text="Welkom in het klantportaal" FontSize="28" FontWeight="SemiBold"/><TextBlock Margin="0,8,0,20" TextWrapping="Wrap" Text="Bekijk uw geplande klus, controleer de status en ontdek onze diensten."/><Border Background="#E8F3F7" Padding="16" CornerRadius="5"><StackPanel><TextBlock Text="Systeemstatus" FontWeight="SemiBold"/><TextBlock x:Name="StatusText" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel></Border><TextBlock Text="Volgende afspraken" Margin="0,24,0,8" FontSize="18" FontWeight="SemiBold"/><ListView x:Name="Appointments" Height="250"><ListView.View><GridView><GridViewColumn Header="Klus" DisplayMemberBinding="{Binding Title}" Width="240"/><GridViewColumn Header="Start" DisplayMemberBinding="{Binding StartTime}" Width="180"/><GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="120"/></GridView></ListView.View></ListView></StackPanel>
</UserControl>
