<UserControl x:Class="AgendaApp.Views.ServicesList" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="Onze diensten" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Prijsindicaties zijn inclusief btw tenzij anders overeengekomen." Margin="0,8,0,16"/><TextBlock x:Name="StatusText" Margin="0,0,0,10" TextWrapping="Wrap"/></StackPanel><ListView x:Name="Services"><ListView.View><GridView><GridViewColumn Header="Dienst" DisplayMemberBinding="{Binding Name}" Width="240"/><GridViewColumn Header="Omschrijving" DisplayMemberBinding="{Binding Description}" Width="430"/><GridViewColumn Header="Prijsindicatie" DisplayMemberBinding="{Binding PriceIndication}" Width="160"/></GridView></ListView.View></ListView></DockPanel></UserControl>
