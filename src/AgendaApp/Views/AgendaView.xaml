<UserControl x:Class="AgendaApp.Views.AgendaView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="Mijn agenda" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Alleen-lezen overzicht van ingeplande werkzaamheden." Margin="0,8,0,16"/><TextBlock x:Name="StatusText" Margin="0,0,0,10" TextWrapping="Wrap"/></StackPanel><ListView x:Name="Appointments"><ListView.View><GridView><GridViewColumn Header="Klus" DisplayMemberBinding="{Binding Title}" Width="260"/><GridViewColumn Header="Van" DisplayMemberBinding="{Binding StartTime}" Width="170"/><GridViewColumn Header="Tot" DisplayMemberBinding="{Binding EndTime}" Width="170"/><GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="120"/><GridViewColumn Header="Notitie" DisplayMemberBinding="{Binding Notes}" Width="220"/></GridView></ListView.View></ListView></DockPanel></UserControl>
