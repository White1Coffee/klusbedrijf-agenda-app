<UserControl x:Class="AgendaApp.Views.ContactForm" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><StackPanel MaxWidth="600" HorizontalAlignment="Left"><TextBlock Text="Neem contact op" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Stuur ons uw vraag; we nemen zo snel mogelijk contact op." Margin="0,8,0,16"/><TextBlock Text="Naam"/><TextBox x:Name="NameBox" Margin="0,4,0,12"/><TextBlock Text="E-mail"/><TextBox x:Name="EmailBox" Margin="0,4,0,12"/><TextBlock Text="Bericht"/><TextBox x:Name="MessageBox" Margin="0,4,0,12" Height="120" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><Button Content="Versturen" HorizontalAlignment="Left" Click="Send_Click"/><TextBlock x:Name="ResultText" Margin="0,14,0,0" TextWrapping="Wrap"/></StackPanel></UserControl>
