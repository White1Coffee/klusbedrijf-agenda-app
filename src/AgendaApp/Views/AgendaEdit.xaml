<UserControl x:Class="AgendaApp.Views.AgendaEdit" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Afspraken beheren" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="StatusText" Margin="0,8,0,10" TextWrapping="Wrap"/><WrapPanel><TextBox x:Name="CustomerIdBox" Width="250" Margin="0,4,8,4" ToolTip="Klant-ID (UUID)"/><TextBox x:Name="TitleBox" Width="180" Margin="0,4,8,4" ToolTip="Titel van de klus"/><DatePicker x:Name="DateBox" Margin="0,4,8,4"/><TextBox x:Name="StartBox" Width="70" Text="09:00" Margin="0,4,8,4" ToolTip="Starttijd, bijvoorbeeld 09:00"/><TextBox x:Name="EndBox" Width="70" Text="10:00" Margin="0,4,8,4" ToolTip="Eindtijd"/><TextBox x:Name="NotesBox" Width="180" Margin="0,4,8,4" ToolTip="Notities"/><Button Content="Afspraak toevoegen" Click="Create_Click"/></WrapPanel><TextBlock Text="Selecteer een afspraak en wijzig de status:" Margin="0,16,0,4"/><WrapPanel><Button Content="Bevestigen" Tag="confirmed" Click="UpdateStatus_Click"/><Button Content="Voltooien" Tag="completed" Click="UpdateStatus_Click"/><Button Content="Annuleren" Tag="cancelled" Click="UpdateStatus_Click"/><Button Content="Vernieuwen" Click="Refresh_Click"/></WrapPanel></StackPanel><ListView Grid.Row="1" x:Name="Appointments" Margin="0,16,0,0"><ListView.View><GridView><GridViewColumn Header="Klus" DisplayMemberBinding="{Binding Title}" Width="220"/><GridViewColumn Header="Klant-ID" DisplayMemberBinding="{Binding CustomerId}" Width="220"/><GridViewColumn Header="Start" DisplayMemberBinding="{Binding StartTime}" Width="160"/><GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="120"/></GridView></ListView.View></ListView></Grid></UserControl>
