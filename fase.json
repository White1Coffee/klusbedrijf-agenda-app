{
  "project": "Klusbedrijf Agenda App",
  "version": "1.0",
  "description": "Windows .exe agenda-app voor klanten en baas, met Supabase database en Docker Windows-container.",
  "steps": [
    {
      "step": 1,
      "title": "Repository & mapstructuur aanmaken",
      "actions": [
        "Maak hoofdmap: klusbedrijf-agenda-app/",
        "Maak submappen: /src, /ui, /db, /config, /docs",
        "Maak bestanden: Dockerfile, README.md, .gitignore"
      ]
    },
    {
      "step": 2,
      "title": "WPF project aanmaken",
      "path": "/src",
      "actions": [
        "Open Visual Studio",
        "Create new project → WPF App (.NET)",
        "Projectnaam: AgendaApp",
        "Visual Studio genereert: App.xaml, MainWindow.xaml, MainWindow.xaml.cs, AgendaApp.csproj"
      ]
    },
    {
      "step": 3,
      "title": "UI-schermen toevoegen",
      "path": "/ui",
      "files": [
        "DashboardCustomer.xaml",
        "DashboardAdmin.xaml",
        "AgendaView.xaml",
        "AgendaEdit.xaml",
        "ServicesList.xaml",
        "Reviews.xaml",
        "ContactForm.xaml"
      ],
      "actions": [
        "Voeg alle .xaml bestanden toe via Visual Studio → Add → Existing Item",
        "Zorg dat alle schermen een Window of UserControl bevatten"
      ]
    },
    {
      "step": 4,
      "title": "Models aanmaken",
      "path": "/src/AgendaApp/Models",
      "files": [
        "Appointment.cs",
        "User.cs",
        "Review.cs",
        "ContactMessage.cs"
      ],
      "actions": [
        "Maak POCO-klassen voor alle database-entiteiten",
        "Gebruik properties die overeenkomen met Supabase-tabellen"
      ]
    },
    {
      "step": 5,
      "title": "Supabase client toevoegen",
      "path": "/src/AgendaApp/Services",
      "files": ["SupabaseClient.cs"],
      "actions": [
        "Lees SUPABASE_URL en SUPABASE_KEY via environment variables",
        "Return een Supabase Client instance"
      ]
    },
    {
      "step": 6,
      "title": "Agenda functionaliteit bouwen",
      "path": "/src/AgendaApp/Services",
      "files": ["AppointmentService.cs"],
      "actions": [
        "Maak een service die afspraken ophaalt via Supabase",
        "Implementeer GetAppointments()",
        "Later uitbreiden met Create, Update, Delete"
      ]
    },
    {
      "step": 7,
      "title": "Dienstenlijst bouwen",
      "path": "/ui/ServicesList.xaml",
      "actions": [
        "Maak een ListBox voor diensten",
        "Voeg standaarddiensten toe in code-behind",
        "Later dynamisch maken via database"
      ]
    },
    {
      "step": 8,
      "title": "Reviews-scherm bouwen",
      "path": "/ui/Reviews.xaml",
      "actions": [
        "Maak een ListBox voor reviews",
        "Later koppelen aan Supabase tabel 'reviews'"
      ]
    },
    {
      "step": 9,
      "title": "Contactformulier bouwen",
      "path": "/ui/ContactForm.xaml",
      "actions": [
        "Maak velden: naam, email, bericht",
        "Maak knop 'Versturen'",
        "Later koppelen aan Supabase tabel 'contacts'"
      ]
    },
    {
      "step": 10,
      "title": "SQL-schema in Supabase zetten",
      "path": "/db/schema.sql",
      "actions": [
        "Plak SQL voor users, appointments, reviews, contacts",
        "Open Supabase → SQL Editor → Run",
        "Controleer of tabellen correct zijn aangemaakt"
      ]
    },
    {
      "step": 11,
      "title": "Build .exe",
      "path": "/src/AgendaApp/bin/Release/net8.0-windows",
      "actions": [
        "Visual Studio → Build Solution",
        "Zoek AgendaApp.exe",
        "Kopieer naar projectroot als agenda-app.exe"
      ]
    },
    {
      "step": 12,
      "title": "Dockerfile toevoegen",
      "path": "/Dockerfile",
      "actions": [
        "Gebruik Windows Nano Server image",
        "COPY agenda-app.exe naar /app",
        "CMD agenda-app.exe"
      ]
    },
    {
      "step": 13,
      "title": "Container bouwen & runnen",
      "actions": [
        "docker build -t klusbedrijf-agenda-app .",
        "docker run -d --name agenda-systeem -e SUPABASE_URL=... -e SUPABASE_KEY=... klusbedrijf-agenda-app"
      ]
    }
  ]
}
